# ── Claude ────────────────────────────────────────────
# Tu clave de https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Haiku es el más rápido (clave para voz). Puedes cambiarlo.
CLAUDE_MODEL=claude-haiku-5-5

# ── Servidor ──────────────────────────────────────────
PORT=3000
# El dominio público que te da ngrok, SIN https:// (ej: abcd-1234.ngrok-free.app)
PUBLIC_HOST=

# ── Twilio (para llamadas reales y SMS) ───────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Tu número de Twilio en formato +1XXXXXXXXXX
TWILIO_FROM_NUMBER=

# ── Panel del dueño ───────────────────────────────────
# Si lo llenas, el panel pide ?token=ESTE_VALOR en la URL
DASHBOARD_TOKEN=

# Restaurante que se usa si el número que recibe la llamada no coincide con ninguno
DEFAULT_RESTAURANT=el-rincon-latino
